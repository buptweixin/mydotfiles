#!/usr/bin/env bash
#
# Run all dotfiles installers, or just the given topics:
#   script/install             # everything
#   script/install ssh tmux    # only these topics' installers

set -euo pipefail

cd "$(dirname "$0")/.."

run_installer() {
	local installer=$1

	echo "› ${installer}"
	bash "$installer"
}

if (( $# > 0 )); then
	for topic in "$@"; do
		installer="./${topic}/install.sh"
		if [[ -f "$installer" ]]; then
			run_installer "$installer"
		else
			echo "no installer for topic '${topic}'" >&2
			exit 1
		fi
	done
	exit 0
fi

installers=()
while IFS= read -r installer; do
	installers+=("$installer")
done < <(find . -maxdepth 2 -name install.sh \
	-not -path './script/install' \
	-not -path './homebrew/install.sh' \
	-not -path './.git/*' \
	| sort)

echo "› ./homebrew/install.sh"
# shellcheck source=homebrew/install.sh
source ./homebrew/install.sh

if ! command -v brew >/dev/null 2>&1; then
	echo 'brew is not available after Homebrew setup' >&2
	exit 1
fi

echo "› brew bundle"
brew bundle --file=Brewfile

for installer in "${installers[@]}"; do
	run_installer "$installer"
done
