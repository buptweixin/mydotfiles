font-family = "Maple Mono NF CN"
font-size = 15
font-thicken = true
adjust-cell-height = 2

# --- Theme and Colors ---
theme = Catppuccin Mocha

# --- Window and Appearance ---
background-opacity = 0.85
background-blur-radius = 30
macos-titlebar-style = transparent
window-padding-x = 10
window-padding-y = 8
window-save-state = always
window-theme = auto

# --- Cursor ---
cursor-style = bar
cursor-style-blink = true
cursor-opacity = 0.8

# --- Mouse ---
mouse-hide-while-typing = true
copy-on-select = clipboard
# Word boundaries for double-click selection: the 1.3 defaults plus = # & * ~,
# so double-clicking "FOO=bar" or "#comment" no longer swallows the whole
# token. Kept as word chars: - . / @ _ ? (paths, emails, URLs stay whole).
selection-word-chars = " \t'\"│`|:;,()[]{}<>=#$&*~"

# --- Keyboard (macOS) ---
# Send the Esc prefix for Option so option+left/right jumps by word
# (pairs with the ^[^[D bindkeys in zsh/config.zsh).
macos-option-as-alt = true

# --- Performance ---
scrollback-limit = 500000

# Keep shell metadata accurate across tabs, splits, tmux, and editor sessions.
shell-integration = zsh
notify-on-command-finish = always

# tabs
keybind = ctrl+q>c=new_tab
keybind = ctrl+q>n=next_tab
keybind = ctrl+q>p=previous_tab

# quick terminal (quake-style dropdown, autohides on focus loss;
# only triggerable while a Ghostty surface has focus)
keybind = super+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.15

# reload config
keybind = ctrl+q>r=reload_config

# tmux
initial-command = /bin/zsh -lc 'exec ~/.dotfiles/bin/tmx'
