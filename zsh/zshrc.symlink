if (( ${+_DOTFILES_ZSHRC_LOADED} )); then
  print -r -- '[zsh] already loaded; use reload!'
  return 0
fi
typeset -g _DOTFILES_ZSHRC_LOADED=1

#=== HELPER METHODS ===================================
function info() { print -P "%F{blue}[INFO]%f: %F{cyan}$1%f"; }

# Cache `<tool> init zsh` output so we don't fork the tool (and generate
# the same script) on every shell startup. Regenerates when the binary is
# newer than the cache, i.e. after an upgrade.
function cached_init() {
  local tool=$1; shift
  local bin cache_dir cache
  command -v "$tool" >/dev/null || return 0
  bin=$(command -v "$tool")
  cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles"
  cache="$cache_dir/$tool-init.zsh"
  if [[ ! -s "$cache" || "$bin" -nt "$cache" ]]; then
    command mkdir -p -- "$cache_dir"
    "$bin" init zsh "$@" >| "$cache" 2>/dev/null && zcompile -Uz "$cache" 2>/dev/null
  fi
  [[ -s "$cache" ]] && source "$cache"
}

# Resolve this script's real location through the ~/.zshrc symlink so the
# layered topics below load from THIS checkout, not an alternate checkout.
export ZSH="${${(%):-%x}:A:h}"

# all of our zsh files
typeset -U config_files
config_files=("$ZSH"/**/*.zsh(N))

# load the path files
for file in ${(M)config_files:#*/path.zsh}
do
  source "$file"
done

# load everything but the path and completion files
for file in ${${config_files:#*/path.zsh}:#*/completion.zsh}
do
  source "$file"
done

#=== LOCAL LOCKED PLUGINS =============================
typeset -g DOTFILES_ZSH_PLUGIN_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/zsh/plugins"
typeset -g OMZ_DIR="$DOTFILES_ZSH_PLUGIN_DIR/oh-my-zsh"
typeset -g ZSH_CACHE_DIR="${ZSH_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles}"
typeset -a missing_plugins
missing_plugins=()

# Keep the small set of OMZ libraries used by this configuration, without
# loading OMZ's brew plugin (Homebrew's path.zsh already handles that setup).
typeset -i omz_files_ok=1
for file in \
  "$OMZ_DIR/lib/clipboard.zsh" \
  "$OMZ_DIR/lib/git.zsh" \
  "$OMZ_DIR/lib/grep.zsh" \
  "$OMZ_DIR/lib/key-bindings.zsh"
do
  if [[ -r "$file" ]]; then
    source "$file"
  else
    omz_files_ok=0
  fi
done
(( omz_files_ok )) || missing_plugins+=(oh-my-zsh)

# zsh-completions must be on fpath before compinit registers completions.
if [[ -d "$DOTFILES_ZSH_PLUGIN_DIR/zsh-completions/src" ]]; then
  fpath=("$DOTFILES_ZSH_PLUGIN_DIR/zsh-completions/src" $fpath)
else
  missing_plugins+=(zsh-completions)
fi

autoload -Uz compinit
compinit

#=== zsh-vim-mode cursor configuration ================
MODE_CURSOR_VICMD="green block";              MODE_CURSOR_VIINS="#20d08a blinking bar"
MODE_INDICATOR_REPLACE='%F{9}%F{1}REPLACE%f'; MODE_INDICATOR_VISUAL='%F{12}%F{4}VISUAL%f'
MODE_INDICATOR_VIINS='%F{15}%F{8}INSERT%f';   MODE_INDICATOR_VICMD='%F{10}%F{2}NORMAL%f'
MODE_INDICATOR_VLINE='%F{12}%F{4}V-LINE%f';   MODE_CURSOR_SEARCH="#ff00ff blinking underline"
setopt PROMPT_SUBST
export KEYTIMEOUT=1
if [[ -r "$DOTFILES_ZSH_PLUGIN_DIR/zsh-vim-mode/zsh-vim-mode.plugin.zsh" ]]; then
  source "$DOTFILES_ZSH_PLUGIN_DIR/zsh-vim-mode/zsh-vim-mode.plugin.zsh"
  bindkey -M vicmd '^e' edit-command-line
else
  missing_plugins+=(zsh-vim-mode)
fi

#=== zsh-autosuggestions ==============================
if [[ -r "$DOTFILES_ZSH_PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
  source "$DOTFILES_ZSH_PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh"
  ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=50
  bindkey '^_' autosuggest-execute
  bindkey '^y' autosuggest-accept
else
  missing_plugins+=(zsh-autosuggestions)
fi

#=== fast-syntax-highlighting =========================
if [[ -r "$DOTFILES_ZSH_PLUGIN_DIR/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh" ]]; then
  source "$DOTFILES_ZSH_PLUGIN_DIR/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh"
  FAST_HIGHLIGHT[chroma-man]=''
else
  missing_plugins+=(fast-syntax-highlighting)
fi

if (( ${#missing_plugins} )); then
  info "Missing zsh plugins: ${(j:, :)missing_plugins}. Run: script/install zsh"
fi

export LC_COLLATE='C'
export LESS='-RMs'
export PAGER=less
RPS1='${MODE_INDICATOR_PROMPT} ${vcs_info_msg_0_}'

# Homebrew provides fzf; the installer creates this local shell integration
# atomically. Never generate it during shell startup.
typeset -g FZF_ZSH_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/fzf.zsh"
if [[ -s "$FZF_ZSH_CACHE" ]]; then
  source "$FZF_ZSH_CACHE"
fi

cached_init starship
cached_init zoxide --cmd z

# Initialize completion styles after compinit has registered local sources.
for file in ${(M)config_files:#*/completion.zsh}
do
  source "$file"
done

unset config_files

# Stash your environment variables in ~/.localrc. This means they'll stay out
# of your main dotfiles repository (which may be public, like this one), but
# you'll have access to them in your scripts.
if [[ -a "$HOME/.localrc" ]]; then
  source "$HOME/.localrc"
fi

if [[ "${TERM_PROGRAM:-}" == "iTerm.app" && -e "$HOME/.iterm2_shell_integration.zsh" ]]; then
  source "$HOME/.iterm2_shell_integration.zsh"

  _dotfiles_iterm2_precmd() {
    print -rn -- "\x1b]1337;CurrentDir=$(pwd)\x07"
  }

  precmd_functions+=(_dotfiles_iterm2_precmd)
fi

if [[ -d /opt/homebrew/share/guile/site/3.0 ]]; then
  export GUILE_LOAD_PATH=/opt/homebrew/share/guile/site/3.0
  export GUILE_LOAD_COMPILED_PATH=/opt/homebrew/lib/guile/3.0/site-ccache
  export GUILE_SYSTEM_EXTENSIONS_PATH=/opt/homebrew/lib/guile/3.0/extensions
fi
